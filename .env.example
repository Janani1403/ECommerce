# Copy to .env and adjust. .env is gitignored.

# ---- Local MySQL (docker compose) ----
DB_ROOT_PASSWORD=rootpass
DB_NAME=ecom
DB_USER=ecom
DB_PASSWORD=ecompass
DB_PORT=3306

# ---- Backend (Ecom.Api) ----
# Local dev uses appsettings.Development.json instead; these are for a deployed env.
# CONNECTION_STRING=Server=...;Port=3306;Database=ecom;Uid=ecom;Pwd=...;
# AdminApi__Token=            # if set, PATCH /store-config + /admin/* need an X-Admin-Token header
# Storage__Provider=local     # local | s3
# Storage__PublicBaseUrl=http://localhost:5056
# Storage__S3__BucketName=
# Storage__S3__Region=

# ---- AI stylist (local testing only; not deployed yet) ----
ANTHROPIC_API_KEY=

# ---- Frontend ----
# Blank in dev (Vite proxies /api). Set to the deployed API origin in prod.
VITE_API_BASE_URL=
