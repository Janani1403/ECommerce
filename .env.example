# Copy to .env and adjust. .env is gitignored.
# ---- Local MySQL (docker compose) ----
DB_ROOT_PASSWORD=rootpass
DB_NAME=ecom
DB_USER=ecom
DB_PASSWORD=ecompass
DB_PORT=3306

# ---- Backend (.NET Lambda, local via SAM) ----
# Connection string the API uses when running locally.
CONNECTION_STRING=Server=host.docker.internal;Port=3306;Database=ecom;Uid=ecom;Pwd=ecompass;

# ---- AI stylist (local testing only; not deployed yet) ----
ANTHROPIC_API_KEY=

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:3000
